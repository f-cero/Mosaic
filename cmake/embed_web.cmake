# SPDX-License-Identifier: Apache-2.0
# Turns a text file into a C header of bytes, so `mosaic video web` can emit a
# single self-contained HTML page with the MVID decoder inlined.
#
#   cmake -DIN=web/mvid.js -DOUT=build/web_mvid_js.h -P cmake/embed_web.cmake
if(NOT DEFINED IN OR NOT DEFINED OUT)
  message(FATAL_ERROR "embed_web.cmake needs -DIN=<file> -DOUT=<header>")
endif()
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" hexlen)
math(EXPR nbytes "${hexlen} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n" body "${body}")
file(WRITE "${OUT}"
"/* SPDX-License-Identifier: Apache-2.0\n"
" * Generated by cmake/embed_web.cmake from web/mvid.js — do not edit.\n"
" * Embedded so the CLI can emit a self-contained HTML player. */\n"
"static const unsigned char k_mvid_js[] = {\n"
"${body}0x00\n"
"};\n"
"static const unsigned long k_mvid_js_len = ${nbytes}ul;\n")
